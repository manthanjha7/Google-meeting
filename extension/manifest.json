{
  "manifest_version": 3,
  "name": "Finrep Meeting Intelligence",
  "version": "1.0.0",
  "description": "Auto-record Google Meet sessions, transcribe Hindi-English, summarize with AI, and post to Slack",
  "permissions": [
    "tabCapture",
    "activeTab",
    "tabs",
    "storage",
    "offscreen",
    "identity"
  ],
  "optional_host_permissions": [],
  "oauth2": {
    "client_id": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly"
    ]
  },
  "host_permissions": [
    "http://localhost:3001/*",
    "http://YOUR_SERVER_IP:3001/*",
    "https://YOUR_SERVER_DOMAIN/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://meet.new/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
