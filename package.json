{
  "name": "finrep-meeting-intelligence",
  "version": "1.0.0",
  "description": "Meeting intelligence pipeline: Chrome extension + backend for recording Google Meet, transcribing via Sarvam STT, summarizing via Claude, and posting to Slack",
  "private": true,
  "scripts": {
    "server": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "jest --testPathPatterns=server/__tests__ --forceExit",
    "package-extension": "node scripts/package-extension.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "clearMocks": true,
    "resetModules": true
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "@azure/storage-blob": "^12.31.0",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "onnxruntime-node": "^1.24.3",
    "openai": "^6.32.0",
    "pdfkit": "^0.18.0",
    "sql.js": "^1.11.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
