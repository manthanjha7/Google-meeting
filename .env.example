# Sarvam AI STT API (core transcription — supports Hindi, English, Hinglish)
SARVAM_API_KEY=your_sarvam_api_key_here

# Azure OpenAI (primary LLM for summarization)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Slack — bot token enables thread-based posting (preferred)
# Bot token: create a Slack App, add chat:write scope, install to workspace
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C1234567890
# Webhook: fallback for simple single-message posting (no thread support)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Server
PORT=3001
UPLOAD_DIR=./uploads
# DB path (optional — defaults to ./meetings.db, use /app/data/meetings.db for Docker)
# DB_PATH=./meetings.db

# Security — shared secret between extension and server.
# Generate with: openssl rand -hex 32
# Set the same value in the Chrome extension settings popup.
API_SECRET=change_me_to_a_random_secret

# CORS — comma-separated list of allowed origins.
# Leave empty to allow all origins (not recommended for production).
# Example: https://your-domain.com,chrome-extension://YOUR_EXTENSION_ID
# CORS_ORIGINS=
